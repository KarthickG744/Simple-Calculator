<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Display Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textColor="#888888"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="start"/>

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="72sp"
            android:textColor="@color/text_white"
            android:gravity="end"
            android:maxLines="1"
            android:adjustViewBounds="true"
            android:ellipsize="start"/>

    </LinearLayout>

    <!-- Buttons Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btnClear"    style="@style/FuncButton" android:text="C"/>
            <Button android:id="@+id/btnPlusMinus" style="@style/FuncButton" android:text="+/-"/>
            <Button android:id="@+id/btnPercent"  style="@style/FuncButton" android:text="%"/>
            <Button android:id="@+id/btnDivide"   style="@style/OpButton"   android:text="÷"/>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn7" style="@style/NumButton" android:text="7"/>
            <Button android:id="@+id/btn8" style="@style/NumButton" android:text="8"/>
            <Button android:id="@+id/btn9" style="@style/NumButton" android:text="9"/>
            <Button android:id="@+id/btnMultiply" style="@style/OpButton" android:text="×"/>
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn4" style="@style/NumButton" android:text="4"/>
            <Button android:id="@+id/btn5" style="@style/NumButton" android:text="5"/>
            <Button android:id="@+id/btn6" style="@style/NumButton" android:text="6"/>
            <Button android:id="@+id/btnSubtract" style="@style/OpButton" android:text="-"/>
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <Button android:id="@+id/btn1" style="@style/NumButton" android:text="1"/>
            <Button android:id="@+id/btn2" style="@style/NumButton" android:text="2"/>
            <Button android:id="@+id/btn3" style="@style/NumButton" android:text="3"/>
            <Button android:id="@+id/btnAdd" style="@style/OpButton" android:text="+"/>
        </LinearLayout>

        <!-- Row 5 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn0"
                style="@style/NumButton"
                android:layout_weight="2"
                android:text="0"
                android:gravity="center_vertical|start"
                android:paddingStart="36dp"/>
            <Button android:id="@+id/btnDot"    style="@style/NumButton" android:text="."/>
            <Button android:id="@+id/btnEquals" style="@style/OpButton"  android:text="="/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
